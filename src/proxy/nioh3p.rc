/* nioh3p resource script: version info + application manifest for the proxy.
 * The DLL is otherwise a resource-less, unsigned image, which is what makes
 * generic AV heuristics (Evo-gen and friends) suspicious. Built by build.sh
 * with llvm-rc and llvm-cvtres; the manifest becomes .rsrc type 24, id 1.
 * Note: llvm-rc escapes a quote inside a string by doubling it, not with \". */

#define RT_MANIFEST 24

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "nioh3p\0"
            VALUE "FileDescription", "DirectInput 8 proxy (Nioh three-player co-op mod)\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "dinput8\0"
            VALUE "LegalCopyright", "open-source mod, no warranty\0"
            VALUE "OriginalFilename", "dinput8.dll\0"
            VALUE "ProductName", "nioh3p\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

/* Application manifest: asInvoker (the game is userland), Windows 10/11
 * compatibility, per-monitor DPI awareness. Stored as RT_MANIFEST/1 so the
 * loader applies it and the startup log can prove it is present. */
1 RT_MANIFEST
BEGIN
    "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>"
    "<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">"
    "<assemblyIdentity type=""win32"" name=""nioh3p.dinput8"" version=""1.0.0.0"" processorArchitecture=""amd64""/>"
    "<trustInfo xmlns=""urn:schemas-microsoft-com:asm.v3"">"
    "<security><requestedPrivileges>"
    "<requestedExecutionLevel level=""asInvoker"" uiAccess=""false""/>"
    "</requestedPrivileges></security></trustInfo>"
    "<compatibility xmlns=""urn:schemas-microsoft-com:compatibility.v1"">"
    "<application>"
    "<supportedOS Id=""{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}""/>"
    "</application></compatibility>"
    "<application xmlns=""urn:schemas-microsoft-com:asm.v3"">"
    "<windowsSettings>"
    "<dpiAware xmlns=""http://schemas.microsoft.com/SMI/2005/WindowsSettings"">true/pm</dpiAware>"
    "<dpiAwareness xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">PerMonitorV2</dpiAwareness>"
    "</windowsSettings></application>"
    "</assembly>"
END
